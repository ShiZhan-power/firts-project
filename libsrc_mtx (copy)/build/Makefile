	$(MAKE) $(MAKESILENT) -f CMakeFiles/kdemo_main.dir/build.make CMakeFiles/kdemo_main.dir/v4l2camera/v4l2camera.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/kdemo_test.dir/build.make CMakeFiles/kdemo_test.dir/v4l2camera/v4l2camera.c.i
.PHONY : v4l2camera/v4l2camera.c.i

v4l2camera/v4l2camera.s: v4l2camera/v4l2camera.c.s
.PHONY : v4l2camera/v4l2camera.s

# target to generate assembly for a file
v4l2camera/v4l2camera.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/kdemo_main.dir/build.make CMakeFiles/kdemo_main.dir/v4l2camera/v4l2camera.c.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/kdemo_test.dir/build.make CMakeFiles/kdemo_test.dir/v4l2camera/v4l2camera.c.s
.PHONY : v4l2camera/v4l2camera.c.s

